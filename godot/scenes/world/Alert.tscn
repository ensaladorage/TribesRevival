[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/view/alert_view.gd" id="script"]
[ext_resource type="Theme" path="res://themes/TribesTheme.tres" id="theme"]

[node name="Alert" type="Node3D"]
script = ExtResource("script")

[node name="Overlay" type="CanvasLayer" parent="."]
layer = 1

[node name="Badge" type="PanelContainer" parent="Overlay"]
custom_minimum_size = Vector2(22, 22)
mouse_filter = 2
theme = ExtResource("theme")
theme_type_variation = &"AlertBadge"

[node name="Mark" type="Label" parent="Overlay/Badge"]
layout_mode = 2
mouse_filter = 2
text = "!"
horizontal_alignment = 1
vertical_alignment = 1
theme_type_variation = &"MenuTitle"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(1, 0.957, 0.851, 1)
