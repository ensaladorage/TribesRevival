[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/TribesTheme.tres" id="theme"]
[node name="SlotsMenu" type="VBoxContainer"]
theme = ExtResource("theme")
theme_override_constants/separation = 12
custom_minimum_size = Vector2(534, 0)

[node name="Title" type="Label" parent="."]
theme_type_variation = &"MenuTitle"
layout_mode = 2
text = "Cargar partida"
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Back" type="Button" parent="."]
layout_mode = 2
text = "Volver"
custom_minimum_size = Vector2(0, 42)
theme_type_variation = &"TribesMenuButton"
