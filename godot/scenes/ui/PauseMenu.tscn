[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/TribesTheme.tres" id="theme"]
[node name="PauseMenu" type="VBoxContainer"]
theme = ExtResource("theme")
theme_override_constants/separation = 12
custom_minimum_size = Vector2(314, 0)

[node name="Title" type="Label" parent="."]
theme_type_variation = &"MenuTitle"
layout_mode = 2
text = "Pausa"
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1

[node name="Resume" type="Button" parent="."]
layout_mode = 2
text = "Volver"
custom_minimum_size = Vector2(0, 42)
theme_type_variation = &"TribesMenuButton"

[node name="Save" type="Button" parent="."]
layout_mode = 2
text = "Guardar"
custom_minimum_size = Vector2(0, 42)
theme_type_variation = &"TribesMenuButton"

[node name="Load" type="Button" parent="."]
layout_mode = 2
text = "Cargar"
custom_minimum_size = Vector2(0, 42)
theme_type_variation = &"TribesMenuButton"

[node name="Main" type="Button" parent="."]
layout_mode = 2
text = "Menú principal"
custom_minimum_size = Vector2(0, 42)
theme_type_variation = &"TribesMenuButton"
