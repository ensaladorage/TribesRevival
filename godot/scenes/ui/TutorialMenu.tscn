[ext_resource type="Texture2D" path="res://assets/ui/tutorial-movement.svg" id="diagram"]

[node name="TutorialMenu" type="VBoxContainer"]
theme = ExtResource("theme")
custom_minimum_size = Vector2(912, 0)
theme_override_constants/separation = 12
metadata/panel_style = "TutorialPanel"

[node name="Title" type="Label" parent="."]
theme_type_variation = &"MenuTitle"
layout_mode = 2
text = "Cómo jugar"
theme_override_font_sizes/font_size = 32

[node name="Movement" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Diagram" type="TextureRect" parent="Movement"]
layout_mode = 2
custom_minimum_size = Vector2(440, 160)
size_flags_horizontal = 3
texture = ExtResource("diagram")
expand_mode = 1
stretch_mode = 5

[node name="Copy" type="VBoxContainer" parent="Movement"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Heading" type="Label" parent="Movement/Copy"]
layout_mode = 2
text = "Mueve el tótem"
theme_override_colors/font_color = Color(0.945, 0.824, 0.478, 1)

[node name="Instructions" type="Label" parent="Movement/Copy"]
layout_mode = 2
text = "Haz clic sobre el tótem y arrástralo. La tribu lo seguirá, se reagrupará y trabajará en los recursos cercanos según las habilidades de cada minion."
custom_minimum_size = Vector2(380, 0)
autowrap_mode = 3
theme_override_font_sizes/font_size = 12

[node name="Hint" type="Label" parent="Movement/Copy"]
layout_mode = 2
text = "Escape: pausar"
theme_override_font_sizes/font_size = 11

[node name="RolesHeading" type="Label" parent="."]
layout_mode = 2
text = "Tu tribu"
theme_override_colors/font_color = Color(0.945, 0.824, 0.478, 1)

[node name="Roles" type="GridContainer" parent="."]
layout_mode = 2
