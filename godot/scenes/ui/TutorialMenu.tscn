[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/TribesTheme.tres" id="theme"]
[ext_resource type="Texture2D" path="res://assets/ui/icon-minion.png" id="minion"]
[ext_resource type="Texture2D" path="res://assets/ui/icon-axe.png" id="axe"]
