[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/TribesTheme.tres" id="theme"]
[node name="MainMenu" type="VBoxContainer"]
theme = ExtResource("theme")
theme_override_constants/separation = 0
custom_minimum_size = Vector2(444, 0)
metadata/panel_style = "MainPanel"

[node name="TitleSpace" type="Control" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(444, 57)
mouse_filter = 2

[node name="Title" type="Label" parent="TitleSpace"]
theme_type_variation = &"MainTitle"
layout_mode = 0
offset_top = -20.0
offset_right = 444.0
offset_bottom = 37.0
text = "Tribes Revival"
theme_override_font_sizes/font_size = 50
horizontal_alignment = 1

[node name="Kicker" type="Label" parent="."]
theme_type_variation = &"MenuKicker"
layout_mode = 2
text = "LA SUPERVIVENCIA DE LA TRIBU DEPENDE DE TI"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.722, 0.851, 0.69, 1)

[node name="ActionGap" type="Control" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
mouse_filter = 2

[node name="Actions" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Play" type="Button" parent="Actions"]
layout_mode = 2
text = "Jugar"
custom_minimum_size = Vector2(270, 42)
size_flags_horizontal = 4
theme_type_variation = &"TribesMenuButton"

[node name="Tutorial" type="Button" parent="Actions"]
layout_mode = 2
text = "Tutorial"
custom_minimum_size = Vector2(270, 42)
size_flags_horizontal = 4
theme_type_variation = &"TribesMenuButton"

[node name="Load" type="Button" parent="Actions"]
layout_mode = 2
text = "Cargar"
custom_minimum_size = Vector2(270, 42)
size_flags_horizontal = 4
theme_type_variation = &"TribesMenuButton"

[node name="Quit" type="Button" parent="Actions"]
layout_mode = 2
text = "Salir"
custom_minimum_size = Vector2(270, 42)
size_flags_horizontal = 4
theme_type_variation = &"TribesMenuButton"
