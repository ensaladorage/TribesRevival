[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/TribesTheme.tres" id="theme"]
[node name="MainMenu" type="VBoxContainer"]
theme = ExtResource("theme")
theme_override_constants/separation = 16
custom_minimum_size = Vector2(444, 0)
metadata/panel_style = "MainPanel"

[node name="Title" type="Label" parent="."]
theme_type_variation = &"MenuTitle"
layout_mode = 2
text = "Tribes Revival"
theme_override_font_sizes/font_size = 50
horizontal_alignment = 1

[node name="Kicker" type="Label" parent="."]
layout_mode = 2
text = "LA SUPERVIVENCIA DE LA TRIBU DEPENDE DE TI"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.722, 0.851, 0.69, 1)

[node name="Play" type="Button" parent="."]
layout_mode = 2
text = "Jugar"
custom_minimum_size = Vector2(270, 42)
size_flags_horizontal = 4
theme_type_variation = &"TribesMenuButton"

[node name="Tutorial" type="Button" parent="."]
layout_mode = 2
text = "Tutorial"
custom_minimum_size = Vector2(270, 42)
size_flags_horizontal = 4
theme_type_variation = &"TribesMenuButton"

[node name="Load" type="Button" parent="."]
layout_mode = 2
text = "Cargar"
custom_minimum_size = Vector2(270, 42)
size_flags_horizontal = 4
theme_type_variation = &"TribesMenuButton"

[node name="Quit" type="Button" parent="."]
layout_mode = 2
text = "Salir"
custom_minimum_size = Vector2(270, 42)
size_flags_horizontal = 4
theme_type_variation = &"TribesMenuButton"
