[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/ui/ResourceCost.tscn" id="cost"]
[ext_resource type="Texture2D" path="res://assets/ui/icon-shield.png" id="shield"]

[node name="EquipmentPanel" type="VBoxContainer"]
theme_override_constants/separation = 5

[node name="shieldRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8
mouse_filter = 2
metadata/item_row = "shield"

[node name="Cost" parent="shieldRow" instance=ExtResource("cost")]
layout_mode = 2
size_flags_vertical = 4
metadata/cost_for = "shield"

[node name="shield" type="Button" parent="shieldRow"]
layout_mode = 2
custom_minimum_size = Vector2(56, 56)
size_flags_horizontal = 0
text = ""
tooltip_text = "shield"
icon = ExtResource("shield")
expand_icon = true
theme_override_constants/icon_max_width = 34
texture_filter = 1
metadata/item = "shield"

